<!--
  Portada (lo primero que se ve al abrir): título, texto de introducción,
  botón JUGAR y, debajo, el logo de la UAO. Los 3 personajes se dibujan encima del
  recuadro desde el juego (son "cartoncitos" 3D).
-->
<style>
  @font-face {
    font-family: "Jersey 25";
    src: url("../fonts/Jersey25-Regular.ttf");
    font-weight: 400;
  }

  .root {
    flex-direction: column;
    align-items: center;
    width: 620px;
    gap: 14px;
    padding-top: 26px;
    padding-bottom: 24px;
    padding-left: 30px;
    padding-right: 30px;
    background-color: rgba(13, 13, 16, 0.82);
    border-radius: 18px;
    border-width: 3px;
    border-color: #55565c;
  }

  .titulo-caja {
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .titulo {
    font-family: "Jersey 25";
    color: #ffffff;
    font-size: 130px;
  }

  .sub {
    font-family: "Jersey 25";
    color: #ffb020;
    font-size: 38px;
  }

  .barra {
    width: 230px;
    height: 7px;
    border-radius: 3px;
    background-color: #1f8a4c;
  }

  .info {
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding-top: 14px;
    padding-bottom: 16px;
    padding-left: 22px;
    padding-right: 22px;
    border-radius: 14px;
    border-width: 2px;
    border-color: #45464c;
    background-color: rgba(34, 34, 42, 0.85);
  }

  .info-titulo {
    font-family: "Jersey 25";
    color: #c9c9d1;
    font-size: 22px;
  }

  .texto {
    font-family: "Jersey 25";
    color: #e6e6ea;
    font-size: 28px;
    text-align: center;
  }

  .pregunta {
    font-family: "Jersey 25";
    color: #ffffff;
    font-size: 36px;
    text-align: center;
  }

  .abajo {
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .logo {
    height: 64px;
    padding-left: 22px;
    padding-right: 22px;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    border-width: 2px;
    border-color: #55565c;
    background-color: #33333d;
  }

  .logo-texto {
    font-family: "Jersey 25";
    color: #e30613;
    font-size: 52px;
  }

  .jugar {
    height: 74px;
    padding-left: 54px;
    padding-right: 54px;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background-color: #ff051e;
    border-width: 4px;
    border-color: #8b0000;
  }

  .jugar-texto {
    font-family: "Jersey 25";
    color: #ffffff;
    font-size: 50px;
    pointer-events: none;
  }
</style>
<div id="fondo" class="root">
  <div class="titulo-caja">
    <span class="titulo">SOBREVIVE</span>
    <span class="sub">A LA UAO</span>
    <div class="barra"></div>
  </div>

  <div class="info">
    <span class="info-titulo">INFORMACIÓN DE LA EXPERIENCIA</span>
    <span class="texto">Algo inesperado ha ocurrido en los sótanos de la UAO.</span>
    <span class="texto">Mantén la calma, sigue la salida y encuentra el punto de encuentro.</span>
    <span class="pregunta">¿Estás listo para sobrevivir?</span>
  </div>

  <div class="abajo">
    <div id="btn-portada-jugar" class="jugar"><span class="jugar-texto">JUGAR</span></div>
    <div class="logo"><span class="logo-texto">uao</span></div>
  </div>
</div>

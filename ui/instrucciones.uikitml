<!--
  Pantalla "¿CÓMO JUGAR?" (diseño de la usuaria del 25 de noviembre): título,
  explicación, tres tarjetas con la mano (saltar, izquierda, derecha) y el
  botón ENTENDIDO. Las manos están en public/img (recortadas de su diseño).
  Los botones y el hundimiento se manejan en src/juego/botones.js; las letras
  llevan pointer-events: none para que siempre responda el botón completo.
  Colores del juego: carbón #22222a / #33333d, rojo UAO #c8102e, botón #ff051e,
  verde #1f8a4c (como la barra de la portada).
  Letra pixel Jersey 25 (public/fonts): trae tildes, ñ y signos ¡ ¿.
-->
<style>
  @font-face {
    font-family: "Jersey 25";
    src: url("../fonts/Jersey25-Regular.ttf");
    font-weight: 400;
  }

  .root {
    flex-direction: column;
    align-items: center;
    width: 640px;
    gap: 20px;
    padding-top: 34px;
    padding-bottom: 36px;
    padding-left: 30px;
    padding-right: 30px;
    background-color: #22222a;
    border-radius: 18px;
    border-width: 4px;
    border-color: #c8102e;
  }

  .titulo {
    font-family: "Jersey 25";
    color: #ffffff;
    font-size: 92px;
  }

  .barra {
    width: 300px;
    height: 8px;
    border-radius: 4px;
    background-color: #1f8a4c;
  }

  .texto {
    font-family: "Jersey 25";
    color: #c9c9d1;
    font-size: 34px;
    text-align: center;
    width: 520px;
  }

  .fila {
    flex-direction: row;
    gap: 28px;
  }

  .tarjeta {
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    border-radius: 18px;
    border-width: 3px;
    border-color: #55565c;
    background-color: #33333d;
  }

  .arriba {
    width: 270px;
    height: 200px;
  }

  .abajo {
    width: 262px;
    height: 190px;
  }

  .mano-saltar {
    pointer-events: none;
    height: 148px;
    width: 126px;
  }

  .mano-lado {
    pointer-events: none;
    height: 128px;
    width: 156px;
  }

  .etiqueta {
    height: 46px;
    padding-left: 26px;
    padding-right: 26px;
    margin-bottom: -20px;
    align-items: center;
    justify-content: center;
    border-radius: 18px;
    background-color: #1f8a4c;
  }

  .etiqueta-texto {
    font-family: "Jersey 25";
    color: #ffffff;
    font-size: 36px;
  }

  .boton {
    width: 400px;
    height: 96px;
    margin-top: 18px;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background-color: #ff051e;
    border-width: 5px;
    border-color: #8b0000;
  }

  .boton-texto {
    font-family: "Jersey 25";
    color: #ffffff;
    font-size: 70px;
    pointer-events: none;
  }
</style>
<div id="fondo" class="root">
  <span class="titulo">¿CÓMO JUGAR?</span>
  <div class="barra"></div>
  <span class="texto">Usa tu mano para moverte, esquivar obstáculos y saltar.</span>

  <div class="tarjeta arriba">
    <img class="mano-saltar" src="../img/mano-saltar.png" />
    <div class="etiqueta"><span class="etiqueta-texto">SALTAR</span></div>
  </div>

  <div class="fila">
    <div class="tarjeta abajo">
      <img class="mano-lado" src="../img/mano-izquierda.png" />
      <div class="etiqueta"><span class="etiqueta-texto">IZQUIERDA</span></div>
    </div>
    <div class="tarjeta abajo">
      <img class="mano-lado" src="../img/mano-derecha.png" />
      <div class="etiqueta"><span class="etiqueta-texto">DERECHA</span></div>
    </div>
  </div>

  <div id="btn-empezar" class="boton"><span class="boton-texto">ENTENDIDO</span></div>
</div>

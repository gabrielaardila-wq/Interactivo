<!--
  Pantalla PERSONAJE (boceto del 25 de noviembre): tarjeta con el título y
  "Ajustar el mapa", tres tarjetas cuadradas (una por personaje) y CONTINUAR.
  Los personajes animados los dibuja el juego encima de las tarjetas: si se
  cambian los altos, anchos o gap de aquí, hay que cambiar TARJETAS_PJ en
  src/juego/juego-system.js.
  Los botones y el hundimiento se manejan en src/juego/botones.js. Las letras llevan
  pointer-events: none para que siempre responda el botón completo.
  Colores del proyecto: carbon #22222a, rojo UAO #c8102e, boton #ff051e.
  Letra pixel Jersey 25 (public/fonts): trae tildes, ñ y signos ¡ ¿.
-->
<style>
  @font-face {
    font-family: "Jersey 25";
    src: url("../fonts/Jersey25-Regular.ttf");
    font-weight: 400;
  }

  .root {
    flex-direction: column;
    align-items: center;
    width: 620px;
    height: 594px;
    gap: 24px;
  }

  .tarjeta-titulo {
    flex-direction: column;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 500px;
    height: 270px;
    gap: 8px;
    background-color: #22222a;
    border-radius: 18px;
    border-width: 4px;
    border-color: #c8102e;
  }

  .title {
    font-family: "Jersey 25";
    color: #ffffff;
    font-size: 100px;
  }

  .hint {
    font-family: "Jersey 25";
    color: #ffb020;
    font-size: 30px;
  }

  .ajustar {
    height: 70px;
    margin-top: 4px;
    padding-left: 28px;
    padding-right: 28px;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background-color: #33333d;
    border-width: 3px;
    border-color: #55565c;
  }

  .ajustar-text {
    font-family: "Jersey 25";
    color: #e6e6ea;
    font-size: 34px;
    pointer-events: none;
  }

  .chars {
    flex-direction: row;
    flex-shrink: 0;
    gap: 34px;
  }

  .char {
    flex-shrink: 0;
    width: 180px;
    height: 180px;
    border-radius: 18px;
    border-width: 5px;
    border-color: #55565c;
    background-color: #33333d;
  }

  .play {
    flex-shrink: 0;
    width: 430px;
    height: 96px;
    align-items: center;
    justify-content: center;
    border-radius: 18px;
    background-color: #ff051e;
    border-width: 5px;
    border-color: #8b0000;
  }

  .play-text {
    font-family: "Jersey 25";
    color: #ffffff;
    font-size: 78px;
    pointer-events: none;
  }
</style>
<div id="fondo" class="root">
  <div class="tarjeta-titulo">
    <span class="title">PERSONAJE</span>
    <span class="hint">Escoge con quién vas a sobrevivir</span>
    <div id="btn-ajustar" class="ajustar"><span class="ajustar-text">Ajustar el mapa</span></div>
  </div>

  <div class="chars">
    <div id="pj-3" class="char"></div>
    <div id="pj-2" class="char"></div>
    <div id="pj-1" class="char"></div>
  </div>

  <div id="btn-jugar" class="play"><span class="play-text">CONTINUAR</span></div>
</div>

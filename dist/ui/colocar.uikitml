<!--
  Paso previo al menú: la persona ubica el mapa donde quiera y le cambia el tamaño.
  Las direcciones son según hacia dónde mira quien juega.
-->
<style>
  @font-face {
    font-family: "Jersey 25";
    src: url("../fonts/Jersey25-Regular.ttf");
    font-weight: 400;
  }

  .root {
    flex-direction: column;
    align-items: center;
    width: 580px;
    gap: 12px;
    padding-top: 20px;
    padding-bottom: 20px;
    padding-left: 22px;
    padding-right: 22px;
    background-color: #22222a;
    border-radius: 18px;
    border-width: 4px;
    border-color: #c8102e;
  }

  .title {
    font-family: "Jersey 25";
    color: #ffffff;
    font-size: 56px;
  }

  .hint {
    font-family: "Jersey 25";
    color: #c9c9d1;
    font-size: 22px;
  }

  .guia {
    font-family: "Jersey 25";
    color: #ffffff;
    font-size: 24px;
  }

  .punto-amarillo {
    width: 22px;
    height: 22px;
    border-radius: 11px;
    background-color: #ffb020;
    border-width: 3px;
    border-color: #ffffff;
  }

  .punto-rojo {
    width: 30px;
    height: 18px;
    border-radius: 9px;
    background-color: #ff051e;
    border-width: 3px;
    border-color: #ffffff;
  }

  .grupo {
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding-top: 8px;
    padding-bottom: 10px;
    padding-left: 12px;
    padding-right: 12px;
    border-radius: 12px;
    background-color: #33333d;
  }

  .grupo-titulo {
    font-family: "Jersey 25";
    color: #ffb020;
    font-size: 24px;
  }

  .fila {
    flex-direction: row;
    gap: 8px;
    align-items: center;
  }

  .btn {
    height: 50px;
    padding-left: 14px;
    padding-right: 14px;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background-color: #55565c;
    border-width: 3px;
    border-color: #6b6c73;
  }

  .btn-text {
    font-family: "Jersey 25";
    color: #ffffff;
    font-size: 26px;
  }

  .valor {
    font-family: "Jersey 25";
    color: #ffffff;
    font-size: 30px;
  }

  .acciones {
    flex-direction: row;
    gap: 12px;
  }

  .btn-mesa {
    height: 60px;
    padding-left: 18px;
    padding-right: 18px;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background-color: #33333d;
    border-width: 3px;
    border-color: #22e07a;
  }

  .btn-listo {
    height: 60px;
    padding-left: 30px;
    padding-right: 30px;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background-color: #ff051e;
    border-width: 4px;
    border-color: #8b0000;
  }

  .btn-grande {
    font-family: "Jersey 25";
    color: #ffffff;
    font-size: 32px;
  }

  .estado {
    font-family: "Jersey 25";
    color: #8c8c96;
    font-size: 19px;
  }
</style>
<div class="root">
  <span class="title">Ajusta el mapa</span>
  <span class="hint">Haz pinza (pulgar + índice) sobre los puntos:</span>
  <div class="fila">
    <div class="punto-amarillo"></div>
    <span class="guia">Esquinas: estíralas para agrandar o achicar</span>
  </div>
  <div class="fila">
    <div class="punto-amarillo"></div>
    <div class="punto-amarillo"></div>
    <span class="guia">Dos esquinas a la vez (una en cada mano): gíralo</span>
  </div>
  <div class="fila">
    <div class="punto-rojo"></div>
    <span class="guia">Manija roja: arrástrala para mover el mapa</span>
  </div>
  <span id="tam-valor" class="valor">100%</span>

  <div class="acciones">
    <div id="btn-buscar-mesa" class="btn-mesa"><span class="btn-text">Buscar la mesa otra vez</span></div>
    <div id="btn-listo" class="btn-listo"><span class="btn-grande">LISTO</span></div>
  </div>
  <span id="estado-colocar" class="estado">Vista de navegador</span>
</div>

<!--
  Panel de inicio (boceto "pantalla de inicio"): logo, escoger personaje y Jugar.
  Colores del proyecto anterior: carbon #22222a, rojo UAO #c8102e, boton #ff051e.
  Letra pixel Jersey 25 (public/fonts): trae tildes, ñ y signos ¡ ¿.
-->
<style>
  @font-face {
    font-family: "Jersey 25";
    src: url("../fonts/Jersey25-Regular.ttf");
    font-weight: 400;
  }

  .root {
    flex-direction: column;
    align-items: center;
    width: 440px;
    padding-top: 22px;
    padding-bottom: 20px;
    padding-left: 26px;
    padding-right: 26px;
    gap: 12px;
    background-color: #22222a;
    border-radius: 18px;
    border-width: 4px;
    border-color: #c8102e;
  }

  .title {
    font-family: "Jersey 25";
    color: #ffffff;
    font-size: 88px;
    font-weight: 400;
  }

  .sub-caja {
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 18px;
    padding-right: 18px;
    border-radius: 8px;
    background-color: #c8102e;
  }

  .sub {
    font-family: "Jersey 25";
    color: #ffffff;
    font-size: 35px;
    font-weight: 400;
  }

  .lema {
    font-family: "Jersey 25";
    color: #ffb020;
    font-size: 23px;
    font-weight: 400;
  }

  .hint {
    font-family: "Jersey 25";
    color: #c9c9d1;
    font-size: 24px;
  }

  .chars {
    flex-direction: row;
    gap: 10px;
  }

  .char {
    padding-top: 9px;
    padding-bottom: 9px;
    padding-left: 14px;
    padding-right: 14px;
    border-radius: 10px;
    border-width: 3px;
    border-color: #33333d;
    background-color: #33333d;
  }

  .char-text {
    font-family: "Jersey 25";
    color: #e6e6ea;
    font-size: 24px;
    font-weight: 400;
  }

  .play {
    width: 320px;
    height: 72px;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background-color: #ff051e;
    border-width: 4px;
    border-color: #8b0000;
  }

  .play-text {
    font-family: "Jersey 25";
    color: #ffffff;
    font-size: 50px;
    font-weight: 400;
  }

  .estado {
    font-family: "Jersey 25";
    color: #8c8c96;
    font-size: 20px;
  }

  .ajustar {
    height: 44px;
    padding-left: 18px;
    padding-right: 18px;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background-color: #33333d;
    border-width: 3px;
    border-color: #55565c;
  }

  .ajustar-text {
    font-family: "Jersey 25";
    color: #e6e6ea;
    font-size: 24px;
  }
</style>
<div class="root">
  <span class="title">PERSONAJE</span>
  <span class="hint">Escoge con quién vas a sobrevivir</span>
  <div class="chars">
    <div id="pj-1" class="char"><span id="pj-1-texto" class="char-text">Personaje 1</span></div>
    <div id="pj-2" class="char"><span id="pj-2-texto" class="char-text">Personaje 2</span></div>
    <div id="pj-3" class="char"><span id="pj-3-texto" class="char-text">Personaje 3</span></div>
  </div>
  <div id="btn-jugar" class="play"><span class="play-text">CONTINUAR</span></div>
  <div id="btn-ajustar" class="ajustar"><span class="ajustar-text">Ajustar el mapa</span></div>
  <span id="estado" class="estado">Vista de navegador: usa las flechas para jugar</span>
</div>

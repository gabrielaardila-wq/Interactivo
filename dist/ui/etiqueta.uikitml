<!--
  Etiqueta flotante sobre la maqueta (INICIO, RAMPA, SALIDA, PUNTO DE ENCUENTRO).
  El texto y el color se ponen desde el juego.
-->
<style>
  @font-face {
    font-family: "Jersey 25";
    src: url("../fonts/Jersey25-Regular.ttf");
    font-weight: 400;
  }

  .caja {
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 14px;
    padding-right: 14px;
    border-radius: 12px;
    border-width: 3px;
    border-color: #0d0d10;
    background-color: #22222a;
  }

  .texto {
    font-family: "Jersey 25";
    color: #ffffff;
    font-size: 33px;
    font-weight: 400;
  }
</style>
<div id="caja" class="caja">
  <span id="texto" class="texto">ETIQUETA</span>
</div>
